<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Publie dist/StsTools sur le Steam Workshop par l'API Steam (SteamUGC), avec le client Steam déjà connecté :
    pas d'identifiants à donner. Lancement : workshop/publish.sh (voir le script).
  -->
  <Import Project="../StsTools.local.props" Condition="Exists('../StsTools.local.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StsDir Condition="'$(StsDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Slay the Spire 2</StsDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET" HintPath="$(StsDir)/data_sts2_linuxbsd_x86_64/Steamworks.NET.dll" />
  </ItemGroup>
</Project>
